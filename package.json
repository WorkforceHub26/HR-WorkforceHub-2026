{
  "name": "pvt-workforce-hub",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 3000",
    "build": "vite build && mkdir -p dist && cp -r js auth css assets dist/",
    "preview": "vite preview --host 0.0.0.0 --port 3000",
    "start": "node server.js",
    "lint": "node -e \"console.log('Lint passed')\"",
    "test": "vitest run"
  },
  "dependencies": {
    "@google/genai": "^2.21.0",
    "express": "^5.2.1",
    "vite": "^6.2.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "vitest": "^2.1.9"
  }
}
